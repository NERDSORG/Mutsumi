{
    "name": "mutsumi",
    "displayName": "%displayName%",
    "description": "%description%",
    "l10n": "./l10n",
    "author": {
        "name": "Malachite",
        "email": "malachiten@outlook.com",
        "url": "https://github.com/MalachiteN"
    },
    "publisher": "Malachite",
    "repository": "github:MalachiteN/Mutsumi",
    "icon": "assets/icon.png",
    "version": "0.0.8",
    "engines": {
        "vscode": "^1.108.0"
    },
    "categories": [
        "AI",
        "Notebooks"
    ],
    "activationEvents": [
        "onNotebook:mutsumi-notebook"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "mutsumi-sidebar",
                    "title": "%viewContainer.title%",
                    "icon": "assets/sidebar-icon.png"
                }
            ]
        },
        "views": {
            "mutsumi-sidebar": [
                {
                    "id": "mutsumi.agentSidebar",
                    "name": "%view.agents.name%",
                    "when": "true",
                    "icon": "assets/sidebar-icon.png"
                },
                {
                    "id": "mutsumi.approvalSidebar",
                    "name": "%view.pendingApprovals.name%",
                    "when": "true",
                    "icon": "assets/sidebar-icon.png"
                },
                {
                    "id": "mutsumi.contextSidebar",
                    "name": "%view.contextItems.name%",
                    "when": "true",
                    "icon": "assets/sidebar-icon.png"
                },
                {
                    "id": "mutsumi.shellTaskSidebar",
                    "name": "%view.shellTasks.name%",
                    "when": "true",
                    "icon": "assets/sidebar-icon.png"
                }
            ]
        },
        "notebooks": [
            {
                "type": "mutsumi-notebook",
                "displayName": "%notebook.displayName%",
                "selector": [
                    {
                        "filenamePattern": "*.mtm"
                    }
                ]
            }
        ],
        "notebookRenderer": [
            {
                "id": "mutsumi-agent-renderer",
                "displayName": "%notebookRenderer.displayName%",
                "entrypoint": "./dist/notebookRenderer.js",
                "mimeTypes": [
                    "application/vnd.mutsumi.agent-chat"
                ]
            }
        ],
        "commands": [
            {
                "command": "mutsumi.newAgent",
                "title": "%command.newAgent.title%"
            },
            {
                "command": "mutsumi.openAgentFile",
                "title": "%command.openAgentFile.title%",
                "category": "Mutsumi"
            },
            {
                "command": "mutsumi.copyReference",
                "title": "%command.copyReference.title%",
                "category": "Mutsumi"
            },
            {
                "command": "mutsumi.approveRequest",
                "title": "%command.approveRequest.title%",
                "icon": "$(check)"
            },
            {
                "command": "mutsumi.rejectRequest",
                "title": "%command.rejectRequest.title%",
                "icon": "$(x)"
            },
            {
                "command": "mutsumi.customRequestAction",
                "title": "%command.customRequestAction.title%",
                "icon": "$(search)"
            },
            {
                "command": "mutsumi.selectModel",
                "title": "%command.selectModel.title%",
                "category": "Mutsumi",
                "icon": "$(server-environment)"
            },
            {
                "command": "mutsumi.renameSession",
                "title": "%command.renameSession.title%",
                "category": "Mutsumi",
                "icon": "$(symbol-keyword)"
            },
            {
                "command": "mutsumi.debugContext",
                "title": "%command.debugContext.title%",
                "category": "Mutsumi",
                "icon": "$(debug-console)"
            },
            {
                "command": "mutsumi.pruneGhostBlocks",
                "title": "%command.pruneGhostBlocks.title%",
                "category": "Mutsumi",
                "icon": "$(history)"
            },
            {
                "command": "mutsumi.toggleAutoApprove",
                "title": "%command.toggleAutoApprove.title%",
                "category": "Mutsumi",
                "icon": "$(run-all)"
            },
            {
                "command": "mutsumi.toggleAutoApproveOn",
                "title": "%command.toggleAutoApproveOn.title%",
                "category": "Mutsumi",
                "icon": "$(debug-disconnect)"
            },
            {
                "command": "mutsumi.testRagSearch",
                "title": "%command.testRagSearch.title%",
                "category": "Mutsumi",
                "icon": "$(search)"
            },
            {
                "command": "mutsumi.compressConversation",
                "title": "%command.compressConversation.title%",
                "category": "Mutsumi",
                "icon": "$(fold)"
            },
            {
                "command": "mutsumi.viewContextItem",
                "title": "%command.viewContextItem.title%",
                "category": "Mutsumi",
                "icon": "$(open-preview)"
            },
            {
                "command": "mutsumi.toggleRule",
                "title": "%command.toggleRule.title%",
                "category": "Mutsumi",
                "icon": "$(check)"
            },
            {
                "command": "mutsumi.toggleSkill",
                "title": "%command.toggleSkill.title%",
                "category": "Mutsumi",
                "icon": "$(check)"
            },
            {
                "command": "mutsumi.removeMacro",
                "title": "%command.removeMacro.title%",
                "category": "Mutsumi",
                "icon": "$(close)"
            },
            {
                "command": "mutsumi.removeFile",
                "title": "%command.removeFile.title%",
                "category": "Mutsumi",
                "icon": "$(close)"
            },
            {
                "command": "mutsumi.refreshContextTree",
                "title": "%command.refreshContextTree.title%",
                "category": "Mutsumi",
                "icon": "$(refresh)"
            },
            {
                "command": "mutsumi.toggleMcpTool",
                "title": "%command.toggleMcpTool.title%",
                "category": "Mutsumi",
                "icon": "$(check)"
            },
            {
                "command": "mutsumi.toggleMcpServer",
                "title": "%command.toggleMcpServer.title%",
                "category": "Mutsumi",
                "icon": "$(check-all)"
            },
            {
                "command": "mutsumi.refreshMcpServers",
                "title": "%command.refreshMcpServers.title%",
                "category": "Mutsumi",
                "icon": "$(refresh)"
            },
            {
                "command": "mutsumi.clearToolCache",
                "title": "%command.clearToolCache.title%",
                "category": "Mutsumi",
                "icon": "$(clear-all)"
            },
            {
                "command": "mutsumi.generateHttpServerPassword",
                "title": "%command.generateHttpServerPassword.title%",
                "category": "Mutsumi",
                "icon": "$(key)"
            },
            {
                "command": "mutsumi.detachShellTask",
                "title": "%command.detachShellTask.title%",
                "icon": "$(debug-disconnect)"
            },
            {
                "command": "mutsumi.killShellTask",
                "title": "%command.killShellTask.title%",
                "icon": "$(debug-stop)"
            },
            {
                "command": "mutsumi.removeShellTask",
                "title": "%command.removeShellTask.title%",
                "icon": "$(close)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "mutsumi.refreshContextTree",
                    "when": "view == mutsumi.contextSidebar",
                    "group": "navigation"
                },
                {
                    "command": "mutsumi.refreshMcpServers",
                    "when": "view == mutsumi.contextSidebar",
                    "group": "navigation@1"
                }
            ],
            "view/item/context": [
                {
                    "command": "mutsumi.openAgentFile",
                    "when": "viewItem == childAgent || viewItem == rootAgent",
                    "group": "inline"
                },
                {
                    "command": "mutsumi.approveRequest",
                    "when": "viewItem == pendingApproval || viewItem == pendingApprovalWithCustom",
                    "group": "inline@1"
                },
                {
                    "command": "mutsumi.rejectRequest",
                    "when": "viewItem == pendingApproval || viewItem == pendingApprovalWithCustom",
                    "group": "inline@2"
                },
                {
                    "command": "mutsumi.customRequestAction",
                    "when": "viewItem == pendingApprovalWithCustom",
                    "group": "inline@0"
                },
                {
                    "command": "mutsumi.toggleRule",
                    "when": "viewItem == ruleActive",
                    "group": "inline",
                    "alt": "mutsumi.toggleRule"
                },
                {
                    "command": "mutsumi.toggleRule",
                    "when": "viewItem == ruleInactive",
                    "group": "inline"
                },
                {
                    "command": "mutsumi.toggleSkill",
                    "when": "viewItem == skillActive",
                    "group": "inline",
                    "alt": "mutsumi.toggleSkill"
                },
                {
                    "command": "mutsumi.toggleSkill",
                    "when": "viewItem == skillInactive",
                    "group": "inline"
                },
                {
                    "command": "mutsumi.toggleMcpTool",
                    "when": "viewItem == mcpToolEnabled || viewItem == mcpToolDisabled",
                    "group": "inline"
                },
                {
                    "command": "mutsumi.toggleMcpServer",
                    "when": "viewItem == mcpServerEnabled || viewItem == mcpServerDisabled",
                    "group": "inline@1"
                },
                {
                    "command": "mutsumi.removeMacro",
                    "when": "viewItem == macro",
                    "group": "inline"
                },
                {
                    "command": "mutsumi.removeFile",
                    "when": "viewItem == file",
                    "group": "inline@1"
                },
                {
                    "command": "mutsumi.detachShellTask",
                    "when": "viewItem == shellTaskRunningForeground",
                    "group": "inline@1"
                },
                {
                    "command": "mutsumi.killShellTask",
                    "when": "viewItem == shellTaskRunningForeground || viewItem == shellTaskRunningBackground",
                    "group": "inline@2"
                },
                {
                    "command": "mutsumi.removeShellTask",
                    "when": "viewItem == shellTaskExitedForeground || viewItem == shellTaskExitedBackground",
                    "group": "inline"
                }
            ],
            "editor/context": [
                {
                    "command": "mutsumi.copyReference",
                    "group": "mutsumi-group",
                    "when": "editorHasSelection"
                },
                {
                    "command": "mutsumi.copyReference",
                    "group": "mutsumi-group",
                    "when": "!editorHasSelection"
                }
            ],
            "explorer/context": [
                {
                    "command": "mutsumi.copyReference",
                    "group": "mutsumi-group"
                }
            ],
            "notebook/toolbar": [
                {
                    "command": "mutsumi.selectModel",
                    "group": "navigation@1",
                    "when": "notebookType == mutsumi-notebook"
                },
                {
                    "command": "mutsumi.renameSession",
                    "group": "navigation@3",
                    "when": "notebookType == mutsumi-notebook"
                },
                {
                    "command": "mutsumi.pruneGhostBlocks",
                    "group": "navigation@4",
                    "when": "notebookType == mutsumi-notebook"
                },
                {
                    "command": "mutsumi.debugContext",
                    "group": "navigation@5",
                    "when": "notebookType == mutsumi-notebook"
                },
                {
                    "command": "mutsumi.toggleAutoApprove",
                    "group": "navigation@6",
                    "when": "notebookType == mutsumi-notebook && !mutsumi:autoApproveEnabled"
                },
                {
                    "command": "mutsumi.toggleAutoApproveOn",
                    "group": "navigation@6",
                    "when": "notebookType == mutsumi-notebook && mutsumi:autoApproveEnabled"
                },
                {
                    "command": "mutsumi.testRagSearch",
                    "group": "navigation@7",
                    "when": "notebookType == mutsumi-notebook"
                },
                {
                    "command": "mutsumi.compressConversation",
                    "group": "navigation@8",
                    "when": "notebookType == mutsumi-notebook"
                }
            ]
        },
        "configuration": {
            "title": "%configuration.title%",
            "properties": {
                "mutsumi.providers": {
                    "type": "array",
                    "markdownDescription": "%configuration.providers.markdownDescription%",
                    "items": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string",
                                "markdownDescription": "%configuration.providers.items.name.markdownDescription%"
                            },
                            "baseurl": {
                                "type": "string",
                                "markdownDescription": "%configuration.providers.items.baseurl.markdownDescription%"
                            },
                            "api_key": {
                                "type": "string",
                                "default": "",
                                "markdownDescription": "%configuration.providers.items.api_key.markdownDescription%"
                            }
                        },
                        "required": [
                            "name",
                            "baseurl",
                            "api_key"
                        ]
                    },
                    "default": []
                },
                "mutsumi.models": {
                    "type": "object",
                    "markdownDescription": "%configuration.models.markdownDescription%",
                    "additionalProperties": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "mutsumi.defaultModel": {
                    "type": "object",
                    "markdownDescription": "%configuration.defaultModel.markdownDescription%",
                    "properties": {
                        "model": {
                            "type": "string"
                        },
                        "provider": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "model",
                        "provider"
                    ],
                    "default": {
                        "model": "kimi-for-coding",
                        "provider": "kimi-for-coding"
                    }
                },
                "mutsumi.titleGeneratorModel": {
                    "type": "object",
                    "markdownDescription": "%configuration.titleGeneratorModel.markdownDescription%",
                    "properties": {
                        "model": {
                            "type": "string"
                        },
                        "provider": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "model",
                        "provider"
                    ]
                },
                "mutsumi.compressModel": {
                    "type": "object",
                    "markdownDescription": "%configuration.compressModel.markdownDescription%",
                    "properties": {
                        "model": {
                            "type": "string"
                        },
                        "provider": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "model",
                        "provider"
                    ]
                },
                "mutsumi.embeddingEndpoint": {
                    "type": "string",
                    "default": "",
                    "description": "%configuration.embeddingEndpoint.description%"
                },
                "mutsumi.shellSyncTimeout": {
                    "type": "number",
                    "default": 60,
                    "minimum": 0,
                    "description": "%configuration.shellSyncTimeout.description%"
                },
                "mutsumi.httpServer.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "%configuration.httpServer.enabled.description%"
                },
                "mutsumi.httpServer.password": {
                    "type": "string",
                    "default": "",
                    "description": "%configuration.httpServer.password.description%"
                },
                "mutsumi.httpServer.host": {
                    "type": "string",
                    "default": "127.0.0.1",
                    "description": "%configuration.httpServer.host.description%"
                },
                "mutsumi.httpServer.port": {
                    "type": "number",
                    "default": 3000,
                    "minimum": 1,
                    "maximum": 65535,
                    "description": "%configuration.httpServer.port.description%"
                },
                "mutsumi.autoApproveEnabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "%configuration.autoApproveEnabled.description%"
                },
                "mutsumi.mcpServers": {
                    "type": "object",
                    "default": {},
                    "markdownDescription": "%configuration.mcpServers.markdownDescription%",
                    "additionalProperties": {
                        "oneOf": [
                            {
                                "type": "object",
                                "properties": {
                                    "type": {
                                        "const": "stdio"
                                    },
                                    "command": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "args": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    "cwd": {
                                        "type": "string"
                                    },
                                    "env": {
                                        "type": "object",
                                        "additionalProperties": {
                                            "type": [
                                                "string",
                                                "number"
                                            ]
                                        }
                                    },
                                    "timeout": {
                                        "type": "number",
                                        "exclusiveMinimum": 0
                                    }
                                },
                                "required": [
                                    "type",
                                    "command"
                                ]
                            },
                            {
                                "type": "object",
                                "properties": {
                                    "type": {
                                        "const": "http"
                                    },
                                    "url": {
                                        "type": "string",
                                        "format": "uri"
                                    },
                                    "headers": {
                                        "type": "object",
                                        "additionalProperties": {
                                            "type": "string"
                                        }
                                    },
                                    "timeout": {
                                        "type": "number",
                                        "exclusiveMinimum": 0
                                    }
                                },
                                "required": [
                                    "type",
                                    "url"
                                ]
                            }
                        ]
                    }
                },
                "mutsumi.agentConfig": {
                    "type": "object",
                    "default": {},
                    "markdownDescription": "%configuration.agentConfig.markdownDescription%",
                    "properties": {
                        "toolSets": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        },
                        "agentTypes": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "object",
                                "properties": {
                                    "toolSets": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    "defaultModel": {
                                        "type": "object",
                                        "properties": {
                                            "model": {
                                                "type": "string"
                                            },
                                            "provider": {
                                                "type": "string"
                                            }
                                        },
                                        "required": [
                                            "model",
                                            "provider"
                                        ]
                                    },
                                    "defaultRules": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    "defaultSkills": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    "defaultMcpServers": {
                                        "type": "array",
                                        "uniqueItems": true,
                                        "items": {
                                            "type": "string"
                                        },
                                        "markdownDescription": "%configuration.agentConfig.defaultMcpServers.markdownDescription%"
                                    },
                                    "allowedChildTypes": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    },
                                    "isEntry": {
                                        "type": "boolean"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "pnpm run check-types && node esbuild.js --production",
        "compile": "pnpm run check-types && node esbuild.js",
        "check-types": "pnpm exec tsc --noEmit && pnpm exec tsc --noEmit -p tsconfig.renderer.json",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "pnpm exec tsc --noEmit --watch",
        "package": "pnpm exec vsce package"
    },
    "packageManager": "pnpm@12.4.1",
    "devDependencies": {
        "@electron/rebuild": "^4.0.3",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@moonshot-ai/kosong": "github:NERDSORG/kimi-code-upstream-monorepo#main&path:packages/kosong",
        "@types/better-sqlite3": "^7.6.13",
        "@types/diff": "^8.0.0",
        "@types/express": "^5.0.6",
        "@types/node": "^24.13.4",
        "@types/node-notifier": "^8.0.5",
        "@types/uuid": "^9.0.8",
        "@types/vscode": "^1.108.1",
        "@vscode/vsce": "^3.6.0",
        "body-parser": "^2.2.2",
        "diff": "^8.0.3",
        "electron": "^39.0.0",
        "electron-rebuild": "^3.2.9",
        "esbuild": "^0.25.0",
        "express": "^5.2.1",
        "gray-matter": "^4.0.3",
        "hast-util-to-html": "^9.0.5",
        "iconv-lite": "^0.6.3",
        "lowlight": "^3.3.0",
        "micromark": "^4.0.0",
        "micromark-extension-gfm": "^2.0.0",
        "npm-run-all": "^4.1.5",
        "openai": "^6.49.0",
        "partial-json": "^0.1.7",
        "preprocess": "^3.2.0",
        "typescript": "^6.0.2",
        "uuid": "^9.0.1"
    },
    "dependencies": {
        "better-sqlite3": "^12.8.0",
        "node-notifier": "^10.0.1",
        "sqlite-vec": "^0.1.7-alpha.2",
        "web-tree-sitter": "^0.22.2"
    }
}
